# ============================================================================
# MultiAgentDevin — Environment Configuration (v1.1.0)
# ============================================================================
# The API key is now resolved from multiple sources (in priority order):
#   1. MCP client env: { "DEVIN_API_KEY": "<key>" } in mcp_config.json
#   2. File-based: ~/.devin/api_key or DEVIN_API_KEY_FILE=/path/to/key
#   3. Devin Desktop config: ~/.codeium/windsurf/mcp_config.json
#   4. This .env file: DEVIN_API_KEY below
# 
# Key types:
#   cog_         → v3 API (service user, recommended for automation)
#   apk_user_    → v1 API (legacy, deprecated)
# ============================================================================

# Devin API Key — get from https://app.devin.ai/settings/api-keys
# Leave empty if using MCP config or file-based auth
DEVIN_API_KEY=

# Alternatively, point to a file containing the key
# DEVIN_API_KEY_FILE=~/.devin/api_key

# Organization ID (required for v3 API / enterprise accounts)
# DEVIN_ORG_ID=your_org_id

# Devin API base URL
DEVIN_API_BASE_URL=https://api.devin.ai

# Dashboard server port (optional, default 3456)
DASHBOARD_PORT=3456

# Dashboard static files path (optional, defaults to ../dashboard/dist)
DASHBOARD_STATIC_PATH=

# Default max ACU limit per agent session (optional, default 20)
DEFAULT_ACU_LIMIT=20

# Default poll interval in ms when waiting for sessions (optional, default 5000)
POLL_INTERVAL_MS=5000

# Enable benchmarking for AI specialist roles (optional, default true)
ENABLE_BENCHMARKING=true
